# Copier en .env et remplir. Ne jamais commiter .env.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # serveur uniquement

# Secrets entre modules (en-tête x-driverss-key)
DRIVERSS_KEY_VOICE=
DRIVERSS_KEY_DISPATCH=

# Telegram (dispatch/bot ; le backend lit aussi le token pour valider l'initData de la Mini App)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INITDATA_MAX_AGE_S=300

# Mini App chauffeur (dispatch/miniapp) : URL publique, utilisée par le bot pour le bouton « ouvrir ».
# La Mini App elle-même ne reçoit que SUPABASE_URL et SUPABASE_ANON_KEY, publics par conception.
TELEGRAM_MINIAPP_URL=

# ElevenLabs (voice, Phase 2)
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
